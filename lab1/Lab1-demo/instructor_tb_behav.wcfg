<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="instructor_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="ece383_pkg" />
            <top_module name="glbl" />
            <top_module name="instructor_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="15,544.600000 us"></ZoomStartTime>
      <ZoomEndTime time="16,165.600001 us"></ZoomEndTime>
      <Cursor1Time time="15,648.100000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="133"></NameColumnWidth>
      <ValueColumnWidth column_width="90"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="4" />
   <wvobject fp_name="/instructor_tb/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/instructor_tb/reset_n" type="logic">
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
      <obj_property name="CustomSignalColor">#00FFFF</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/instructor_tb/position" type="array">
      <obj_property name="ElementShortName">position</obj_property>
      <obj_property name="ObjectShortName">position</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/instructor_tb/position.row" type="array">
         <obj_property name="ElementShortName">.row[9:0]</obj_property>
         <obj_property name="ObjectShortName">.row[9:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
         <obj_property name="CustomSignalColor">#800000</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/instructor_tb/position.col" type="array">
         <obj_property name="ElementShortName">.col[9:0]</obj_property>
         <obj_property name="ObjectShortName">.col[9:0]</obj_property>
         <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
         <obj_property name="CustomSignalColor">#808000</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/instructor_tb/position.row" type="array">
         <obj_property name="ElementShortName">.row[9:0]</obj_property>
         <obj_property name="ObjectShortName">.row[9:0]</obj_property>
      </wvobject>
      <wvobject fp_name="/instructor_tb/position.col" type="array">
         <obj_property name="ElementShortName">.col[9:0]</obj_property>
         <obj_property name="ObjectShortName">.col[9:0]</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="/instructor_tb/vga" type="array">
      <obj_property name="ElementShortName">vga</obj_property>
      <obj_property name="ObjectShortName">vga</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/instructor_tb/vga.hsync" type="logic">
         <obj_property name="ElementShortName">.hsync</obj_property>
         <obj_property name="ObjectShortName">.hsync</obj_property>
         <obj_property name="CustomSignalColor">#800080</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/instructor_tb/vga.vsync" type="logic">
         <obj_property name="ElementShortName">.vsync</obj_property>
         <obj_property name="ObjectShortName">.vsync</obj_property>
         <obj_property name="CustomSignalColor">#FFD700</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
      <wvobject fp_name="/instructor_tb/vga.blank" type="logic">
         <obj_property name="ElementShortName">.blank</obj_property>
         <obj_property name="ObjectShortName">.blank</obj_property>
         <obj_property name="CustomSignalColor">#FF0000</obj_property>
         <obj_property name="UseCustomSignalColor">true</obj_property>
      </wvobject>
   </wvobject>
</wave_config>

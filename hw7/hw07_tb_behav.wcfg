      <obj_property name="ElementShortName">processQ[10:0]</obj_property>
      <obj_property name="ObjectShortName">processQ[10:0]</obj_property>
      <obj_property name="label">Count</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
